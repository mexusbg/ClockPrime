<?xml version="1.0" encoding="utf-8"?>
<!-- Dual clock: local time beside the first world-clock city. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,NestedWeights" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/dual_local_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_gold" android:text="Sofia"/>
    <TextClock android:id="@+id/dual_local_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-light" android:textSize="26sp" android:textColor="@color/w_text" android:format12Hour="h:mm" android:format24Hour="HH:mm"/>
    <TextView android:id="@+id/dual_local_day" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/w_muted" android:text="Wed, Oct 21"/>
  </LinearLayout>
  <FrameLayout android:layout_width="1dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="@color/w_line"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/dual_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_accent" android:text="London"/>
    <TextClock android:id="@+id/dual_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false" android:fontFamily="sans-serif-light" android:textSize="26sp" android:textColor="@color/w_text" android:format12Hour="h:mm" android:format24Hour="HH:mm"/>
    <TextView android:id="@+id/dual_day" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/w_muted" android:text="Wed · −2:00"/>
  </LinearLayout>
</LinearLayout>
