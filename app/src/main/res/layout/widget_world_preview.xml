<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the World clock widget: header and sample rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,NestedWeights,UselessParent,UseCompoundDrawables,RtlSymmetry" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp">
  <LinearLayout android:id="@+id/list_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingBottom="6dp">
    <ImageView android:id="@+id/list_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_world" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
      <TextView android:id="@+id/list_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_text" android:text="@string/widget_world_name"/>
      <TextView android:id="@+id/list_summary" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/w_muted" android:text=""/>
    </LinearLayout>
    <ImageView android:id="@+id/list_add" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_widget_add" android:background="@drawable/widget_chip_accent" android:contentDescription="@string/add_alarm"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_accent" android:text="London"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_muted" android:text="Wed, Oct 21 · −2:00"/>
      </LinearLayout>
      <TextClock android:timeZone="Europe/London" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:fontFamily="sans-serif-light" android:textSize="20sp" android:textColor="@color/w_text" android:format12Hour="h:mm a" android:format24Hour="HH:mm"/>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_accent" android:text="New York"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_muted" android:text="Wed, Oct 21 · −7:00"/>
      </LinearLayout>
      <TextClock android:timeZone="America/New_York" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:fontFamily="sans-serif-light" android:textSize="20sp" android:textColor="@color/w_text" android:format12Hour="h:mm a" android:format24Hour="HH:mm"/>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_accent" android:text="Tokyo"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/w_muted" android:text="Thu, Oct 22 · +6:00"/>
      </LinearLayout>
      <TextClock android:timeZone="Asia/Tokyo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:fontFamily="sans-serif-light" android:textSize="20sp" android:textColor="@color/w_text" android:format12Hour="h:mm a" android:format24Hour="HH:mm"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
